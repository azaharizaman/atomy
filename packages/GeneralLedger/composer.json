{
    "name": "azaharizaman/nexus-general-ledger",
    "description": "Atomic package for general ledger management - central transaction hub for all financial entries, ledger account management, transaction recording, balance calculation, and trial balance generation",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Nexus Team",
            "email": "team@nexus.example.com"
        }
    ],
    "require": {
        "brick/math": "^0.12",
        "azaharizaman/nexus-common": "dev-main",
        "php": "^8.3"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "Nexus\\GeneralLedger\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Nexus\\GeneralLedger\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "suggest": {
        "azaharizaman/nexus-chart-of-account": "dev-main",
        "azaharizaman/nexus-journal-entry": "dev-main",
        "azaharizaman/nexus-period": "dev-main"
    }
}
