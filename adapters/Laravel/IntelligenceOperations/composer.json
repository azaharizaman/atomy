{
    "name": "azaharizaman/nexus-laravel-intelligence-operations-adapter",
    "description": "Laravel adapters for IntelligenceOperations orchestrator ports",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "illuminate/support": "^11.0|^12.0",
        "illuminate/cache": "^11.0|^12.0",
        "azaharizaman/nexus-intelligence-operations": "dev-main",
        "azaharizaman/nexus-machine-learning": "dev-main",
        "azaharizaman/nexus-query-engine": "dev-main",
        "azaharizaman/nexus-telemetry": "dev-main",
        "psr/log": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "Nexus\\Laravel\\IntelligenceOperations\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Nexus\\Laravel\\IntelligenceOperations\\Providers\\IntelligenceOperationsAdapterServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
