{
    "name": "azaharizaman/nexus-human-resource-operations",
    "description": "HR Operations Orchestrator - Coordinates all HR domain packages including Leave, Attendance, Payroll, Employee, Shift, Disciplinary, Performance Review, Training, Recruitment, and Onboarding",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "azaharizaman/nexus-common": "dev-main",
        "azaharizaman/nexus-employee-profile": "dev-main",
        "azaharizaman/nexus-attendance-management": "dev-main",
        "azaharizaman/nexus-leave-management": "dev-main",
        "azaharizaman/nexus-shift-management": "dev-main",
        "azaharizaman/nexus-disciplinary": "dev-main",
        "azaharizaman/nexus-performance-review": "dev-main",
        "azaharizaman/nexus-training-management": "dev-main",
        "azaharizaman/nexus-recruitment": "dev-main",
        "azaharizaman/nexus-onboarding": "dev-main",
        "azaharizaman/nexus-payroll": "dev-main",
        "azaharizaman/nexus-payroll-mys-statutory": "dev-main",
        "azaharizaman/nexus-identity": "dev-main",
        "azaharizaman/nexus-crypto": "dev-main",
        "psr/log": "^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "Nexus\\HumanResourceOperations\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Nexus\\HumanResourceOperations\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
