{
    "name": "azaharizaman/nexus-receivable",
    "description": "Accounts Receivable (A/R) package for Nexus ERP - manages customer invoicing, payment receipts, credit control, and collections",
    "type": "library",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Nexus\\Receivable\\": "src/"
        }
    },
    "require": {
        "azaharizaman/nexus-currency": "dev-main",
        "php": "^8.3",
        "psr/log": "^3.0"
    },
    "autoload-dev": {
        "psr-4": {
            "Nexus\\Receivable\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "suggest": {
        "azaharizaman/nexus-accounting": "dev-main",
        "azaharizaman/nexus-audit-logger": "dev-main",
        "azaharizaman/nexus-party": "dev-main",
        "azaharizaman/nexus-period": "dev-main",
        "azaharizaman/nexus-sales": "dev-main",
        "azaharizaman/nexus-sequencing": "dev-main"
    }
}
