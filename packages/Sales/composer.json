{
    "name": "azaharizaman/nexus-sales",
    "description": "Framework-agnostic sales management package for quotation-to-order lifecycle",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Nexus Development Team",
            "email": "dev@nexus-erp.com"
        }
    ],
    "require": {
        "php": "^8.3",
        "psr/log": "^3.0"
    },
    "suggest": {
        "azaharizaman/nexus-party": "dev-main",
        "azaharizaman/nexus-product": "dev-main",
        "azaharizaman/nexus-uom": "dev-main",
        "azaharizaman/nexus-currency": "dev-main",
        "azaharizaman/nexus-accounting": "dev-main",
        "azaharizaman/nexus-sequencing": "dev-main",
        "azaharizaman/nexus-period": "dev-main",
        "azaharizaman/nexus-audit-logger": "dev-main",
        "azaharizaman/nexus-inventory": "dev-main",
        "azaharizaman/nexus-receivable": "dev-main"
    },
    "autoload": {
        "psr-4": {
            "Nexus\\Sales\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Nexus\\Sales\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
