{
    "name": "azaharizaman/nexus-procurement-operations",
    "description": "Nexus ProcurementOperations Orchestrator - Cross-package workflow coordination for Procure-to-Pay (P2P) processes",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "nexus",
        "orchestrator",
        "procurement",
        "procure-to-pay",
        "p2p",
        "purchase-order",
        "goods-receipt",
        "invoice-matching",
        "3-way-match"
    ],
    "require": {
        "php": "^8.3",
        "azaharizaman/nexus-procurement": "*@dev",
        "azaharizaman/nexus-payable": "*@dev",
        "azaharizaman/nexus-inventory": "*@dev",
        "azaharizaman/nexus-journal-entry": "*@dev",
        "azaharizaman/nexus-budget": "*@dev",
        "azaharizaman/nexus-workflow": "*@dev",
        "azaharizaman/nexus-party": "*@dev",
        "azaharizaman/nexus-period": "*@dev",
        "azaharizaman/nexus-currency": "*@dev",
        "azaharizaman/nexus-notifier": "*@dev",
        "azaharizaman/nexus-audit-logger": "*@dev",
        "azaharizaman/nexus-setting": "*@dev",
        "azaharizaman/nexus-tax": "*@dev",
        "azaharizaman/nexus-compliance": "*@dev",
        "azaharizaman/nexus-document": "*@dev",
        "azaharizaman/nexus-crypto": "*@dev",
        "psr/log": "^3.0",
        "psr/event-dispatcher": "^1.0"
    },
    "repositories": [
        {
            "type": "path",
            "url": "../../packages/Crypto",
            "options": {
                "symlink": true
            }
        }
    ],
    "autoload": {
        "psr-4": {
            "Nexus\\ProcurementOperations\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Nexus\\ProcurementOperations\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
