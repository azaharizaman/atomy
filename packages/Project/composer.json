{
    "name": "azaharizaman/nexus-project",
    "description": "Core project entity and lifecycle rules: metadata, PM assignment, status and completion rules, client visibility.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "azaharizaman/nexus-common": "dev-main",
        "psr/log": "^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "Nexus\\Project\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Nexus\\Project\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
