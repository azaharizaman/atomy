{
    "name": "azaharizaman/nexus-budget",
    "description": "Financial budget management and control plane for Nexus ERP",
    "type": "library",
    "version": "1.0.0",
    "license": "MIT",
    "authors": [
        {
            "name": "Nexus Development Team",
            "email": "dev@nexus.local"
        }
    ],
    "require": {
        "azaharizaman/nexus-audit-logger": "*@dev",
        "azaharizaman/nexus-common": "*@dev",
        "azaharizaman/nexus-currency": "*@dev",
        "azaharizaman/nexus-machine-learning": "*@dev",
        "azaharizaman/nexus-notifier": "*@dev",
        "azaharizaman/nexus-period": "*@dev",
        "azaharizaman/nexus-procurement": "*@dev",
        "azaharizaman/nexus-setting": "*@dev",
        "azaharizaman/nexus-uom": "*@dev",
        "azaharizaman/nexus-workflow": "*@dev",
        "php": "^8.3",
        "psr/event-dispatcher": "^1.0",
        "psr/log": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "Nexus\\Budget\\": "src/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "suggest": {
        "azaharizaman/nexus-accounting": "Optional integration dependency; currently not referenced by package src.",
        "azaharizaman/nexus-party": "Optional integration dependency; currently not referenced by package src."
    }
}
