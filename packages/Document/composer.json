{
    "name": "azaharizaman/nexus-document",
    "description": "Framework-agnostic document management engine for Nexus ERP monorepo",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Azahari Zaman",
            "email": "azahari@example.com"
        }
    ],
    "require": {
        "php": "^8.3",
        "azaharizaman/nexus-storage": "dev-main",
        "azaharizaman/nexus-crypto": "dev-main",
        "azaharizaman/nexus-audit-logger": "dev-main",
        "azaharizaman/nexus-tenant": "dev-main",
        "psr/log": "^3.0",
        "symfony/uid": "^7.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "Nexus\\Document\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Nexus\\Document\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
