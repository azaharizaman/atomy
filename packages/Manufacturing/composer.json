{
    "name": "azaharizaman/nexus-manufacturing",
    "description": "Framework-agnostic manufacturing and production management for Nexus ERP - BOM, Work Orders, Routings, MRP, CRP with ML-powered demand forecasting",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Nexus Architecture Team",
            "email": "architecture@nexus-erp.com"
        }
    ],
    "require": {
        "php": "^8.3",
        "psr/log": "^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "suggest": {
        "azaharizaman/nexus-event-stream": "dev-main",
        "azaharizaman/nexus-inventory": "dev-main",
        "azaharizaman/nexus-machine-learning": "dev-main",
        "azaharizaman/nexus-product": "dev-main",
        "azaharizaman/nexus-uom": "dev-main",
        "azaharizaman/nexus-warehouse": "dev-main",
        "azaharizaman/nexus-workflow": "dev-main"
    },
    "autoload": {
        "psr-4": {
            "Nexus\\Manufacturing\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Nexus\\Manufacturing\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "test": "phpunit",
        "test:coverage": "phpunit --coverage-html coverage"
    }
}
