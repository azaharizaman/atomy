{
    "name": "azaharizaman/nexus-procurement-operations",
    "description": "Nexus ProcurementOperations Orchestrator - Cross-package workflow coordination for Procure-to-Pay (P2P) processes",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "nexus",
        "orchestrator",
        "procurement",
        "procure-to-pay",
        "p2p",
        "purchase-order",
        "goods-receipt",
        "invoice-matching",
        "3-way-match"
    ],
    "require": {
        "php": "^8.3",
        "azaharizaman/nexus-procurement": "dev-main",
        "azaharizaman/nexus-payable": "dev-main",
        "azaharizaman/nexus-inventory": "dev-main",
        "azaharizaman/nexus-journal-entry": "dev-main",
        "azaharizaman/nexus-budget": "dev-main",
        "azaharizaman/nexus-workflow": "dev-main",
        "azaharizaman/nexus-party": "dev-main",
        "azaharizaman/nexus-period": "dev-main",
        "azaharizaman/nexus-currency": "dev-main",
        "azaharizaman/nexus-notifier": "dev-main",
        "azaharizaman/nexus-audit-logger": "dev-main",
        "azaharizaman/nexus-setting": "dev-main",
        "azaharizaman/nexus-tax": "dev-main",
        "azaharizaman/nexus-compliance": "dev-main",
        "azaharizaman/nexus-document": "dev-main",
        "azaharizaman/nexus-crypto": "dev-main",
        "psr/log": "^3.0",
        "psr/event-dispatcher": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "Nexus\\ProcurementOperations\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Nexus\\ProcurementOperations\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
