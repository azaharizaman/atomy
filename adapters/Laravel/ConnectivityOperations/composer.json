{
    "name": "azaharizaman/nexus-laravel-connectivity-operations-adapter",
    "description": "Laravel adapters for ConnectivityOperations orchestrator ports",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "illuminate/support": "^11.0|^12.0",
        "illuminate/cache": "^11.0|^12.0",
        "azaharizaman/nexus-connectivity-operations": "dev-main",
        "azaharizaman/nexus-connector": "dev-main",
        "azaharizaman/nexus-crypto": "dev-main",
        "azaharizaman/nexus-telemetry": "dev-main",
        "azaharizaman/nexus-feature-flags": "dev-main",
        "psr/log": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "Nexus\\Laravel\\ConnectivityOperations\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Nexus\\Laravel\\ConnectivityOperations\\Providers\\ConnectivityOperationsAdapterServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
