{
    "name": "azaharizaman/nexus-laravel-insight-operations-adapter",
    "description": "Laravel adapters for InsightOperations orchestrator ports",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "illuminate/support": "^11.0|^12.0",
        "azaharizaman/nexus-insight-operations": "dev-main",
        "azaharizaman/nexus-query-engine": "dev-main",
        "azaharizaman/nexus-machine-learning": "dev-main",
        "azaharizaman/nexus-export": "dev-main",
        "azaharizaman/nexus-storage": "dev-main",
        "psr/log": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "Nexus\\Laravel\\InsightOperations\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Nexus\\Laravel\\InsightOperations\\Providers\\InsightOperationsAdapterServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
