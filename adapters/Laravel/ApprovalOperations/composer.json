{
    "name": "azaharizaman/nexus-laravel-approval-operations-adapter",
    "description": "Laravel adapter for Nexus ApprovalOperations (Layer 3): Eloquent persistence, workflow bridge stub.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "illuminate/database": "^11.0|^12.0",
        "illuminate/support": "^11.0|^12.0",
        "azaharizaman/nexus-approval-operations": "dev-main"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "Nexus\\Laravel\\ApprovalOperations\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Nexus\\Laravel\\ApprovalOperations\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Nexus\\Laravel\\ApprovalOperations\\Providers\\ApprovalOperationsAdapterServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
