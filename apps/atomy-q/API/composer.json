    "license": "proprietary",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "php": "^8.3",
        "firebase/php-jwt": "^6.10",
        "laravel/framework": "^12.0",
        "laravel/tinker": "^2.10.1",
        "league/flysystem-aws-s3-v3": "^3.0",
        "azaharizaman/nexus-aml-compliance": "dev-main",
        "azaharizaman/nexus-approval-operations": "dev-main",
        "azaharizaman/nexus-audit-logger": "dev-main",
        "azaharizaman/nexus-common": "dev-main",
        "azaharizaman/nexus-compliance": "dev-main",
        "azaharizaman/nexus-compliance-operations": "dev-main",
        "azaharizaman/nexus-connectivity-operations": "dev-main",
        "azaharizaman/nexus-connector": "dev-main",
        "azaharizaman/nexus-crypto": "dev-main",
        "azaharizaman/nexus-currency": "dev-main",
        "azaharizaman/nexus-data-exchange-operations": "dev-main",
        "azaharizaman/nexus-document": "dev-main",
        "azaharizaman/nexus-event-stream": "dev-main",
        "azaharizaman/nexus-export": "dev-main",
        "azaharizaman/nexus-feature-flags": "dev-main",
        "azaharizaman/nexus-idempotency": "dev-main",
        "azaharizaman/nexus-identity": "dev-main",
        "azaharizaman/nexus-identity-operations": "dev-main",
        "azaharizaman/nexus-insight-operations": "dev-main",
        "azaharizaman/nexus-intelligence-operations": "dev-main",
        "azaharizaman/nexus-laravel-approval-operations-adapter": "dev-main",
        "azaharizaman/nexus-laravel-idempotency-adapter": "dev-main",
        "azaharizaman/nexus-laravel-identity-adapter": "dev-main",
        "azaharizaman/nexus-laravel-notifier-adapter": "dev-main",
        "azaharizaman/nexus-laravel-setting-adapter": "dev-main",
        "azaharizaman/nexus-laravel-sourcing-adapter": "dev-main",
        "azaharizaman/nexus-laravel-tenant-adapter": "dev-main",
        "azaharizaman/nexus-machine-learning": "dev-main",
        "azaharizaman/nexus-messaging": "dev-main",
        "azaharizaman/nexus-notifier": "dev-main",
        "azaharizaman/nexus-outbox": "dev-main",
        "azaharizaman/nexus-party": "dev-main",
        "azaharizaman/nexus-policy-engine": "dev-main",
        "azaharizaman/nexus-procurement": "dev-main",
        "azaharizaman/nexus-procurement-operations": "dev-main",
        "azaharizaman/nexus-project": "dev-main",
        "azaharizaman/nexus-project-management-operations": "dev-main",
        "azaharizaman/nexus-query-engine": "dev-main",
        "azaharizaman/nexus-quotation-intelligence": "dev-main",
        "azaharizaman/nexus-reporting": "dev-main",
        "azaharizaman/nexus-sanctions": "dev-main",
        "azaharizaman/nexus-scheduler": "dev-main",
        "azaharizaman/nexus-sequencing": "dev-main",
        "azaharizaman/nexus-setting": "dev-main",
        "azaharizaman/nexus-settings-management": "dev-main",
        "azaharizaman/nexus-sourcing": "dev-main",
        "azaharizaman/nexus-sourcing-operations": "dev-main",
        "azaharizaman/nexus-sso": "dev-main",
        "azaharizaman/nexus-storage": "dev-main",
        "azaharizaman/nexus-task": "dev-main",
        "azaharizaman/nexus-tenant": "dev-main",
        "azaharizaman/nexus-tenant-operations": "dev-main",
        "azaharizaman/nexus-uom": "dev-main",
        "azaharizaman/nexus-vendor": "dev-main",
        "azaharizaman/nexus-laravel-vendor-adapter": "dev-main",
        "azaharizaman/nexus-workflow": "dev-main"
    },
    "require-dev": {
        "dedoc/scramble": "^0.13.15",
        "fakerphp/faker": "^1.23",
        "laravel/pail": "^1.2",
        "laravel/pint": "^1.24",
        "laravel/sail": "^1.53",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "test": [
            "@php artisan config:clear --ansi",
            "@php artisan test"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": [
                "azaharizaman/nexus-laravel-approval-operations-adapter"
            ]
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true
        }
    }
}
