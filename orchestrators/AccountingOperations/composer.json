{
    "name": "azaharizaman/nexus-accounting-operations",
    "description": "Nexus AccountingOperations Orchestrator - Cross-package workflow coordination for accounting processes",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "azaharizaman/nexus-chart-of-account": "*@dev",
        "azaharizaman/nexus-journal-entry": "*@dev",
        "azaharizaman/nexus-period": "*@dev",
        "azaharizaman/nexus-budget": "*@dev",
        "azaharizaman/nexus-currency": "*@dev",
        "psr/log": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "Nexus\\AccountingOperations\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Nexus\\AccountingOperations\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
